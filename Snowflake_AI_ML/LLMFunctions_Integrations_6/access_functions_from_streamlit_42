import streamlit as st
from snowflake.snowpark import get_active_session

st.header("Basic ChatGPT Q&A interface")
session=get_active_session()
if prompt:=st.text_input(
    label='Ask a question and click enter:',
    value='What is Snowflake Data Cloud'
    )
    prompt=prompt.replace("'","''")
    query=f"select test.db.public.openai('{prompt}')"
    response=session.sql(query).collect()[0][0]
    st.write(response)