WITH input AS (
    SELECT
     {
        'country':country,
        'department': department
     } AS categorical_dimensions,
     {
        
     } AS continous_dimensions,
     transactions::float AS metric,
     IFF
        (
            ds 
                BETWEEN '2020-08-01' AND '2020-08-20', TRUE, FALSE                
        ) AS label
    FROM    
        sales
    WHERE
        (
            ds BETWEEN 
                '2020-05-01' AND '2020-05-20'
        )
        OR 
        (ds BETWEEN
            '2020-08-01' AND '2020-08-20'
        )
)
SELECT 
    res.*
FROM 
    input,
    TABLE(
        snowflake.ml.top_insights(
            categorical_dimensions,
            continous_dimensions,
            metric,
            label
        ) OVER (PARTITION BY 0)
    ) res
ORDER BY 
    surprise
DESC;